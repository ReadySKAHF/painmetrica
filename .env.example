# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Redis
REDIS_URL=redis://127.0.0.1:6379/1

# Supabase Storage (медиафайлы)
# Получить в Supabase Dashboard → Project Settings → Storage → S3 Access Keys
SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_S3_ACCESS_KEY=<access-key-id>
SUPABASE_S3_SECRET_KEY=<secret-access-key>
SUPABASE_S3_REGION=eu-central-1
SUPABASE_STORAGE_BUCKET=media
# Получить в Supabase Dashboard → Storage → выбрать bucket → Get URL
# Формат: <project-ref>.supabase.co/storage/v1/object/public/media
SUPABASE_STORAGE_PUBLIC_DOMAIN=<project-ref>.supabase.co/storage/v1/object/public/media

# Database (Supabase PostgreSQL)
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-db-password
DB_HOST=aws-1-eu-central-1.pooler.supabase.com
DB_PORT=6543

# Email (Gmail SMTP)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=Painmetrica <your-email@gmail.com>
