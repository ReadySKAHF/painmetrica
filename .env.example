#  Django
SECRET_KEY=замените-на-случайную-строку-50-символов
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com


#  База данных (Supabase / PostgreSQL)
# Transaction Pooler Supabase: порт 6543
# Session Pooler Supabase:     порт 5432
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-supabase-db-password
DB_HOST=aws-0-eu-central-1.pooler.supabase.com
DB_PORT=6543

#  Redis (имя сервиса Docker Compose)
REDIS_URL=redis://redis:6379/1

#  Email (Gmail SMTP)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=xxxx-xxxx-xxxx-xxxx
DEFAULT_FROM_EMAIL=Painmetrica <your-email@gmail.com>

#  Supabase Storage (S3-совместимое хранилище)
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_S3_REGION=eu-central-1
SUPABASE_STORAGE_BUCKET=media
SUPABASE_STORAGE_PUBLIC_DOMAIN=
